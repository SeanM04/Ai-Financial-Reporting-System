# Backend environment configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Django ---------------------------------------------------------------
# Production: DEBUG=False and a real SECRET_KEY (startup fails otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# Setting DB_NAME selects PostgreSQL (settings_postgres). Remove the DB_* lines to use SQLite.
DB_NAME=financial_analytics
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# --- Browser origins ------------------------------------------------------
# Origins allowed to call the API and to send POST requests (CSRF).
# Production: your site's origin only, e.g. https://reports.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to CORS_ALLOWED_ORIGINS when unset.
# CSRF_TRUSTED_ORIGINS=https://reports.example.com

# --- Production behind nginx (HTTPS) --------------------------------------
# BEHIND_PROXY=true trusts X-Forwarded-Proto / X-Forwarded-For from nginx.
# BEHIND_PROXY=true
# SECURE_SSL_REDIRECT=True
# Start with 3600; raise to 31536000 once HTTPS works everywhere.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# --- Shared cache ---------------------------------------------------------
# Rate limits, AI quota counters and locks must be shared by all server processes.
# Without REDIS_URL a database table is used (created by `python manage.py migrate`).
# REDIS_URL=redis://localhost:6379/1

# --- Uploads and API --------------------------------------------------------
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
API_PAGE_SIZE=20

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.7
# Keep OPENAI_TIMEOUT_SECONDS * (OPENAI_MAX_RETRIES + 1) below GUNICORN_TIMEOUT (300).
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Total OpenAI requests per day across all users (0 = no cap).
OPENAI_DAILY_QUOTA_LIMIT=1000

# --- Rate limits ------------------------------------------------------------
AI_REQUESTS_PER_USER_PER_HOUR=30
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_LOCKOUT_SECONDS=900

# --- Logging ----------------------------------------------------------------
# LOG_DIR=/var/log/financial-analytics
# LOG_LEVEL=INFO
